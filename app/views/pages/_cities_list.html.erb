<div id="cities_list">
  <% if country_groups.any? %>
    <div class="mb-4 text-sm font-medium text-slate-500">
      <%= pluralize(total_cities_count, "city") %> cataloged across <%= pluralize(country_groups.size, "country") %>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-[44rem] w-full table-fixed divide-y divide-slate-200 text-left">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="w-1/5 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              City
            </th>
            <th scope="col" class="w-1/2 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              Description
            </th>
            <th scope="col" class="w-3/10 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              Thematic Tags
            </th>
          </tr>
        </thead>

        <% country_groups.each do |country, cities| %>
          <tbody class="divide-y divide-slate-200">
            <tr class="bg-slate-100/80 border-y border-slate-200">
              <th colspan="3" scope="colgroup" class="px-5 py-3 text-left">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-slate-900"><%= country.name %></span>
                    <span class="inline-flex items-center rounded-full bg-slate-200/80 px-2 py-0.5 text-[11px] font-medium text-slate-700">
                      <%= country.continent&.name %>
                    </span>
                  </div>
                  <span class="text-xs font-medium text-slate-500"><%= pluralize(cities.size, "city") %></span>
                </div>
              </th>
            </tr>

            <% cities.each do |city| %>
              <tr class="align-top transition hover:bg-slate-50/70">
                <td class="px-5 py-4 text-sm font-semibold text-slate-900">
                  <%= link_to city.name, city_path(city), class: "text-indigo-600 hover:text-indigo-500 hover:underline" %>
                </td>
                <td class="px-5 py-4 text-sm leading-relaxed text-slate-600">
                  <%= city.description %>
                </td>
                <td class="px-5 py-4">
                  <% if city.themes.any? %>
                    <ul class="flex flex-wrap gap-1.5" aria-label="Themes for <%= city.name %>">
                      <% city.themes.each do |theme| %>
                        <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                          <%= theme %>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    <span class="text-xs text-slate-400">No tags</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <h2 class="text-base font-semibold text-slate-900">No cities yet</h2>
      <p class="mt-1 text-sm text-slate-600">
        <% if countries_count.zero? %>
          First <%= link_to "populate countries", countries_path, class: "font-medium text-indigo-600 hover:text-indigo-500 underline" %>, then click <span class="font-medium text-slate-800">Populate Cities</span> above to discover urban centers.
        <% else %>
          Click <span class="font-medium text-slate-800">Populate Cities</span> above to have the agent discover cities across your <%= pluralize(countries_count, "country") %>.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
