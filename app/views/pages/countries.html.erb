<% content_for :title, "Countries | Statesman" %>

<%= turbo_stream_from PopulateCountriesJob::STREAM_NAME %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Countries</h1>
      <p class="mt-2 text-sm text-slate-600">
        Explore sovereign states across continents or ask the discovery agent to discover countries by continent.
      </p>
    </div>

    <div class="shrink-0">
      <%= render "pages/populate_controls",
                 target_id: "countries_populate_controls",
                 action_path: populate_countries_path,
                 idle_label: "Populate Countries",
                 running_label: "Discovering Countries...",
                 running: false,
                 status_message: notice,
                 status_kind: (notice.present? ? :info : nil) %>
    </div>
  </header>

  <%= render "pages/countries_list",
             continent_groups: @continent_groups,
             total_countries_count: @total_countries_count,
             continents_count: @continents_count %>
</div>
