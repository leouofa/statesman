<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "cities/modal", city: @city %>
<% else %>
  <% content_for :title, "#{@city.name} | Cities | Statesman" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@city) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Cities", cities_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "View Country (#{@city.country.name}) →", country_path(@city.country), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
          <%= @city.country.continent.name %>
        </span>
        <span class="text-xs text-slate-500">&bull;</span>
        <span class="text-xs font-medium text-slate-600"><%= @city.country.name %></span>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= @city.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @city.description %></p>

      <% if @city.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Thematic tags for <%= @city.name %>">
          <% @city.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "shared/embedding_panel",
               record: @city,
               action_path: generate_embedding_city_path(@city),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
