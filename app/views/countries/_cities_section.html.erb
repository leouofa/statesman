<div id="country_cities_section" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
  <div class="flex items-center justify-between border-b border-slate-100 pb-4">
    <div>
      <h2 class="text-base font-semibold text-slate-900">Cities in <%= country.name %></h2>
      <p class="text-xs text-slate-500 mt-0.5"><%= pluralize(country.cities.size, "city") %> cataloged</p>
    </div>

    <%= button_to populate_cities_country_path(country),
                  method: :post,
                  class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition cursor-pointer" do %>
      <span>Populate Cities for <%= country.name %></span>
    <% end %>
  </div>

  <% if local_assigns[:status_message].present? %>
    <p role="status" class="rounded-md border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-800">
      <%= status_message %>
    </p>
  <% end %>

  <% if country.cities.any? %>
    <div class="divide-y divide-slate-100">
      <% country.cities.ordered.each do |city| %>
        <div class="py-3 first:pt-0 last:pb-0 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <%= link_to city.name, city_path(city), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500 hover:underline" %>
              <% if city.embedded? %>
                <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 text-[10px] font-medium text-emerald-700">
                  Embedded
                </span>
              <% end %>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed"><%= city.description %></p>
            <% if city.themes.any? %>
              <div class="flex flex-wrap gap-1 pt-1">
                <% city.themes.each do |t| %>
                  <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">
                    <%= t %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <%= link_to "View →", city_path(city), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800 shrink-0 pt-0.5" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-xs text-slate-500 italic py-2">
      No cities cataloged yet for <%= country.name %>. Click "Populate Cities for <%= country.name %>" to discover them.
    </p>
  <% end %>
</div>
